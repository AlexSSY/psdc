<b>here login form</b>

<%= form_for @form do |f| %>
    <div class="max-w-100 mx-auto">
        <%= render FormFieldComponent.new(builder: f, attribute: :email) %>
        <%= render FormFieldComponent.new(builder: f, attribute: :password, type: :password) %>
        <div class="flex justify-end w-full">
            <%= f.submit "Login", class: "bg-red-500 text-white px-4 py-3 rounded-full cursor-pointer" %>
        </div>
        <div class="mt-3 text-center">
            <%= link_to "Sign Up", new_registrations_path, class: "underline hover:text-red-500" %>
        </div>
    </div>
<% end %>