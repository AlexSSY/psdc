<b>here registration form</b>

<%= form_for @form do |f| %>
    <div class="max-w-100 mx-auto">
        <%= render FormFieldComponent.new(builder: f, attribute: :email) %>
        <%= render FormFieldComponent.new(builder: f, attribute: :password, type: :password) %>
        <%= render FormFieldComponent.new(builder: f, attribute: :password_confirmation, type: :password) %>
        <div class="flex justify-end w-full">
            <%= f.submit "Register", class: "bg-red-500 text-white px-4 py-3 rounded-full cursor-pointer" %>
        </div>
    </div>
<% end %>